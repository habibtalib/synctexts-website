---
interface Props {
  type: 'Product' | 'SoftwareApplication';
  name: string;
  description: string;
  url: string;
  category?: string;
  availability?: 'InStock' | 'PreOrder';
  inLanguage?: string[];
  /** Numeric price; offers are only emitted when set (Google flags priceless Offers) */
  price?: string | number;
}

const {
  type,
  name,
  description,
  url,
  category,
  availability = 'InStock',
  inLanguage,
  price,
} = Astro.props;

// Pricing is quoted on request, so offers are omitted unless a price is passed
const schema = {
  '@context': 'https://schema.org',
  '@type': type,
  name,
  description,
  url,
  brand: {
    '@type': 'Brand',
    name: 'SyncTexts',
  },
  ...(type === 'SoftwareApplication'
    ? { applicationCategory: category ?? 'BusinessApplication', operatingSystem: 'Web' }
    : category ? { category } : {}),
  ...(inLanguage ? { inLanguage } : {}),
  ...(price !== undefined
    ? {
        offers: {
          '@type': 'Offer',
          url,
          price: String(price),
          priceCurrency: 'MYR',
          availability: `https://schema.org/${availability}`,
          seller: {
            '@type': 'Organization',
            name: 'SyncTexts',
            url: 'https://synctexts.com',
          },
        },
      }
    : {}),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

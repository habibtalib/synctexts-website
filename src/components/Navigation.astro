---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/training', label: 'Training' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/team', label: 'Team' },
  { href: '/blog', label: 'Blog' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/contact', label: 'Contact' },
];

const productLinks = [
  { href: '/cloud', label: 'SyncTexts Cloud', desc: 'Managed hosting & VPS' },
  { href: '/os', label: 'SyncTexts OS', desc: 'Business OS for SMEs (early access)' },
  { href: 'https://pelatih.my', label: 'Pelatih.my', desc: 'Hands-on tech training platform', external: true },
];

const productsActive = productLinks.some((p) => currentPath.startsWith(p.href));

function isActive(linkHref: string): boolean {
  if (linkHref === '/') {
    return currentPath === '/' || currentPath === '';
  }
  return currentPath.startsWith(linkHref);
}
---

<nav class="glass-nav">
  <div class="container nav-content">
    <a href="/" class="logo">
      <span class="logo-sync">Sync</span><span class="logo-texts">Texts</span>
      <span class="logo-dot">.</span>
    </a>

    <div class="nav-links-desktop">
      {navLinks.map((link) => (
        <Fragment>
          <a href={link.href} class:list={[{ active: isActive(link.href) }]}>
            {link.label}
          </a>
          {link.href === '/' && (
            <div class="nav-dropdown">
              <button
                type="button"
                class:list={['nav-dropdown-toggle', { active: productsActive }]}
                aria-expanded="false"
                aria-controls="nav-products-menu"
              >
                Products
                <svg class="nav-dropdown-chevron" viewBox="0 0 10 10" aria-hidden="true">
                  <path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </button>
              <div class="nav-dropdown-menu" id="nav-products-menu">
                <div class="nav-dropdown-panel">
                  {productLinks.map((p) => (
                    <a
                      href={p.href}
                      aria-current={currentPath.startsWith(p.href) ? 'page' : undefined}
                      {...(p.external ? { target: '_blank', rel: 'noopener' } : {})}
                    >
                      <span class="nav-dropdown-name">{p.label}</span>
                      <span class="nav-dropdown-desc">{p.desc}</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          )}
        </Fragment>
      ))}
      <a href="/contact" class="btn btn-primary">Start Project</a>
    </div>

    <button
      class="hamburger"
      aria-expanded="false"
      aria-controls="mobile-sidebar"
      aria-label="Toggle navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<div class="sidebar-overlay" aria-hidden="true"></div>
<div class="mobile-sidebar" id="mobile-sidebar" aria-hidden="true" inert>
  {navLinks.map((link) => (
    <Fragment>
      <a href={link.href} class:list={['sidebar-link', { active: isActive(link.href) }]}>
        {link.label}
      </a>
      {link.href === '/' && (
        <Fragment>
          <span class="sidebar-group-label">Products</span>
          {productLinks.map((p) => (
            <a
              href={p.href}
              class:list={['sidebar-link', 'sidebar-sublink', { active: currentPath.startsWith(p.href) }]}
              {...(p.external ? { target: '_blank', rel: 'noopener' } : {})}
            >
              {p.label}
            </a>
          ))}
        </Fragment>
      )}
    </Fragment>
  ))}
  <a href="/contact" class="btn btn-primary btn-block">Start Project</a>
</div>

<script>
  // Products dropdown: click/Enter toggles, ArrowDown opens and focuses the first item,
  // Escape closes and returns focus, focus leaving or an outside click closes.
  // Listeners are re-bound per page load; the controller drops the previous page's set.
  let dropdownAbort: AbortController | null = null;

  function initProductsDropdown() {
    dropdownAbort?.abort();
    dropdownAbort = new AbortController();
    const { signal } = dropdownAbort;

    const dropdown = document.querySelector<HTMLElement>('.nav-dropdown');
    const toggle = dropdown?.querySelector<HTMLButtonElement>('.nav-dropdown-toggle');
    if (!dropdown || !toggle) return;
    const items = () => Array.from(dropdown.querySelectorAll<HTMLAnchorElement>('.nav-dropdown-panel a'));

    const setOpen = (open: boolean) => {
      dropdown.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => setOpen(!dropdown.classList.contains('open')), { signal });

    dropdown.addEventListener('keydown', (e) => {
      const list = items();
      const idx = list.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'Escape') {
        setOpen(false);
        toggle.focus();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        setOpen(true);
        list[(idx + 1) % list.length]?.focus();
      } else if (e.key === 'ArrowUp' && idx >= 0) {
        e.preventDefault();
        list[(idx - 1 + list.length) % list.length]?.focus();
      }
    }, { signal });

    dropdown.addEventListener('focusout', (e) => {
      if (!dropdown.contains(e.relatedTarget as Node | null)) setOpen(false);
    }, { signal });

    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node)) setOpen(false);
    }, { signal });
  }

  document.addEventListener('astro:page-load', initProductsDropdown);

  // Mobile sidebar: inert while closed so its links leave the tab order; Escape closes
  // and returns focus to the hamburger. Same per-page AbortController pattern as above.
  let sidebarAbort: AbortController | null = null;

  function setSidebarOpen(open: boolean) {
    const hamburger = document.querySelector('.hamburger');
    const sidebar = document.querySelector<HTMLElement>('.mobile-sidebar');
    const overlay = document.querySelector('.sidebar-overlay');

    hamburger?.setAttribute('aria-expanded', String(open));
    if (sidebar) {
      sidebar.classList.toggle('open', open);
      sidebar.setAttribute('aria-hidden', String(!open));
      sidebar.inert = !open;
    }
    overlay?.classList.toggle('open', open);
    document.body.classList.toggle('sidebar-open', open);
  }

  function initMobileSidebar() {
    sidebarAbort?.abort();
    sidebarAbort = new AbortController();
    const { signal } = sidebarAbort;

    const hamburger = document.querySelector<HTMLButtonElement>('.hamburger');
    const sidebar = document.querySelector<HTMLElement>('.mobile-sidebar');
    const overlay = document.querySelector('.sidebar-overlay');

    if (!hamburger || !sidebar || !overlay) return;

    const closeSidebar = () => setSidebarOpen(false);

    hamburger.addEventListener('click', () => {
      setSidebarOpen(hamburger.getAttribute('aria-expanded') !== 'true');
    }, { signal });

    overlay.addEventListener('click', closeSidebar, { signal });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sidebar.classList.contains('open')) {
        closeSidebar();
        hamburger.focus();
      }
    }, { signal });

    // Close sidebar on link click
    sidebar.querySelectorAll('.sidebar-link').forEach((link) => {
      link.addEventListener('click', closeSidebar, { signal });
    });
  }

  document.addEventListener('astro:page-load', initMobileSidebar);

  // Close sidebar before View Transition navigation
  document.addEventListener('astro:before-preparation', () => {
    document.querySelector('.nav-dropdown')?.classList.remove('open');
    document.querySelector('.nav-dropdown-toggle')?.setAttribute('aria-expanded', 'false');
    setSidebarOpen(false);
  });
</script>
